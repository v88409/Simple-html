# Get from my.telegram.org
API_ID=
API_HASH=

# Get from @BotFather
BOT_TOKEN=
BOT_USERNAME=

# Get from @userinfobot
OWNER_ID=

# Optional: space-separated additional admin user IDs. Defaults to OWNER_ID if left empty.
SUDO_USERS=

# Log channel ID (bot must be admin there)
CHANNEL_ID=

# Force-subscribe channel ID (bot must be admin there)
CHANNEL_ID2=

# MongoDB connection string (e.g. from MongoDB Atlas free tier)
MONGO_URL=

# Channel/chat ID used for premium-related logs
PREMIUM_LOGS=

# Optional: default thumbnail image URL
THUMB_URL=https://i.ibb.co/DPCmWSKV/1000003297-3.png
